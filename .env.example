# Токен сообщества ВК: Управление → Работа с API → Ключи доступа.
# Нужны права на сообщения. Также включи "Возможности ботов" в настройках сообщений.
VK_TOKEN=vk1.a.xxxxxxxx

# Кому слать ежедневный дайджест: user id (или peer id беседы: 2000000000 + номер),
# через запятую. Пользователь должен разрешить сообщения от сообщества.
# Можно оставить пустым — тогда бот работает только по кнопке «Запросить туры».
VK_PEER_IDS=

# Время ежедневного запуска (локальное)
RUN_AT=09:00

# Файл SQLite
DB_PATH=tours.db

# Коды tourvisor: город вылета и страна (Екатеринбург=3, Вьетнам=16)
TV_CITY=3
TV_COUNTRY=16

# Окно вылета: строго больше FROM и строго меньше TO дней от сегодня.
WINDOW_FROM_DAYS=5
WINDOW_TO_DAYS=12

# Сколько взрослых (учитывается в графике цен; карточки modhot и так считаются на двоих)
ADULTS=2

# Длительность тура в ночах, включительно
NIGHTS_FROM=8
NIGHTS_TO=11

# Потолок цены «обычных» туров для второго графика, руб.
PRICE_LIMIT=300000
